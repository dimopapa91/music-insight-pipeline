# Copy to .env and fill in your own keys. Never commit the real .env.

# --- Required ---
LASTFM_API_KEY=your_lastfm_key
ANTHROPIC_API_KEY=your_anthropic_key
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret

# Secret key for signing user login sessions. REQUIRED in production —
# set a long random value in Railway (e.g. `python -c "import secrets; print(secrets.token_hex(32))"`).
SECRET_KEY=change_me_to_a_long_random_string

# --- Database ---
# Set in production (Railway provides this automatically). Leave unset locally
# to use a local `music_insights` PostgreSQL database for the current OS user.
# DATABASE_URL=postgresql://user:password@host:5432/music_insights

# --- Optional: weekly email digest ---
DIGEST_EMAIL_FROM=your@gmail.com
DIGEST_EMAIL_TO=your@gmail.com
GMAIL_APP_PASSWORD=your_gmail_app_password

# --- Optional: self-hosted analytics (/admin/stats) ---
# Username of the account allowed to view /admin/stats. Everyone else
# (including anonymous visitors) gets a 404. Leave unset to disable the
# page entirely.
ADMIN_USERNAME=your_waveline_username

# Absolute path to a MaxMind GeoLite2-Country.mmdb file, used to show a
# "top countries" breakdown on /admin/stats. Optional — if unset (or the
# file can't be read), country is just recorded as NULL and everything
# else keeps working. See README "GeoIP setup". Never commit the .mmdb file.
# GEOIP_DB_PATH=/path/to/GeoLite2-Country.mmdb
